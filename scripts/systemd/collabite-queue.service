[Unit]
Description=Collabite Laravel queue worker (1Panel / Docker PHP)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
# /usr/local/bin/php di 1Panel = wrapper "docker exec … php84"
# Harus root (atau user di group docker) agar bisa akses /var/run/docker.sock
User=root
Group=root

# Path di HOST (document root 1Panel)
WorkingDirectory=/opt/1panel/www/sites/collabite.rizqis.com/index

# Cara A (disarankan): panggil wrapper php 1Panel
ExecStart=/usr/local/bin/php artisan queue:work --sleep=3 --tries=3 --backoff=60 --max-time=3600 --timeout=90

# Cara B (eksplisit docker) — uncomment & comment Cara A jika wrapper bermasalah:
# ExecStart=/usr/bin/docker exec -i -w /www/sites/collabite.rizqis.com/index php84 php artisan queue:work --sleep=3 --tries=3 --backoff=60 --max-time=3600 --timeout=90

Restart=always
RestartSec=5
Nice=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=collabite-queue

[Install]
WantedBy=multi-user.target
